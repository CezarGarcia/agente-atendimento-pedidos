# Copie para .env e ajuste. Todos os valores abaixo são exclusivos de desenvolvimento local.

# --- Modelo de IA (Anthropic) ---------------------------------------------
# Sem chave, o agente sobe normalmente e responde com a mensagem de indisponibilidade
# nos turnos que dependem do modelo (confirmações e templates continuam funcionando).
ANTHROPIC_API_KEY=
# Modelos aceitos: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low

# --- Conversa ----------------------------------------------------------------
CONFIRMATION_TTL_MINUTES=10
CONVERSATION_IDLE_MINUTES=30

# --- Integrações -------------------------------------------------------------
FAKESTORE_BASE_URL=https://fakestoreapi.com

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PASSWORD=postgres_dev_only
ORDERS_DB_PASSWORD=orders_dev_only
AGENT_DB_PASSWORD=agent_dev_only
POSTGRES_PORT=5432

# --- Segredos de desenvolvimento (proibidos com NODE_ENV=production) ---------
AGENT_ORDERS_API_KEY=dev-agent-key-change-me
SWAGGER_ORDERS_API_KEY=dev-swagger-key-change-me
CHANNEL_WEBHOOK_SECRET=dev-webhook-secret-change-me
LOG_PSEUDONYM_SECRET=dev-pseudonym-secret-change-me

# --- Portas expostas ---------------------------------------------------------
ORDERS_API_PORT=3001
AGENT_PORT=3002
