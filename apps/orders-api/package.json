{
  "name": "@agente/orders-api",
  "version": "0.1.0",
  "private": true,
  "description": "API principal de pedidos: consulta e cancelamento com regras de negócio.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "openapi": "tsx src/scripts/export-openapi.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.1",
    "tsup": "9.0.0"
  },
  "dependencies": {
    "@agente/shared": "0.1.0",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  }
}
